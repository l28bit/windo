+function _windo_new_live_stream_state {
+    param(
+        [Parameter(Mandatory=$true)][string]$Path,
+        [Parameter(Mandatory=$true)][ValidateSet("stdout", "stderr")][string]$Channel
+    )
+    return [pscustomobject]@{
+        Path = $Path
+        Channel = $Channel
+        Reader = $null
+        Stream = $null
+        OpenFailed = $false
+        BytesObserved = [long]0
+    }
+}
+
+function _windo_open_live_stream_reader {
+    param([Parameter(Mandatory=$true)]$State)
+    if ($null -ne $State.Reader -or [bool]$State.OpenFailed) { return }
+    if (-not (Test-Path -LiteralPath ([string]$State.Path) -PathType Leaf)) { return }
+    try {
+        $share = [System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete
+        $stream = [System.IO.FileStream]::new(
+            [string]$State.Path,
+            [System.IO.FileMode]::Open,
+            [System.IO.FileAccess]::Read,
+            $share
+        )
+        $reader = [System.IO.StreamReader]::new(
+            $stream,
+            [System.Text.UTF8Encoding]::new($false, $true),
+            $true,
+            4096,
+            $false
+        )
+        $State.Stream = $stream
+        $State.Reader = $reader
+    } catch {
+        $State.OpenFailed = $true
+        try { if ($null -ne $State.Reader) { $State.Reader.Dispose() } } catch { }
+        try { if ($null -ne $State.Stream) { $State.Stream.Dispose() } } catch { }
+        $State.Reader = $null
+        $State.Stream = $null
+    }
+}
+
+function _windo_pump_live_stream {
+    param(
+        [Parameter(Mandatory=$true)]$State,
+        [bool]$Emit = $true
+    )
+    _windo_open_live_stream_reader -State $State
+    if ($null -eq $State.Reader) { return 0 }
+    try {
+        $chunk = [string]$State.Reader.ReadToEnd()
+        if ([string]::IsNullOrEmpty($chunk)) { return 0 }
+        $charCount = $chunk.Length
+        $State.BytesObserved = [long]$State.BytesObserved + [long][System.Text.Encoding]::UTF8.GetByteCount($chunk)
+        if ($Emit) {
+            try {
+                if ([string]$State.Channel -ceq "stderr") {
+                    [Console]::Error.Write($chunk)
+                    [Console]::Error.Flush()
+                } else {
+                    [Console]::Out.Write($chunk)
+                    [Console]::Out.Flush()
+                }
+            } catch {
+                Write-Host -NoNewline $chunk
+            }
+        }
+        return $charCount
+    } catch {
+        return 0
+    }
+}
+
+function _windo_close_live_stream_state {
+    param([AllowNull()]$State)
+    if ($null -eq $State) { return }
+    try { if ($null -ne $State.Reader) { $State.Reader.Dispose() } } catch { }
+    try { if ($null -ne $State.Stream) { $State.Stream.Dispose() } } catch { }
+    $State.Reader = $null
+    $State.Stream = $null
+}
+
+function _windo_signal_runner_cancel {
+    param(
+        [Parameter(Mandatory=$true)][string]$CancelPath,
+        [Parameter(Mandatory=$true)][string]$RequestId,
+        [string]$Reason = "caller-cancelled"
+    )
+    try {
+        $payload = [ordered]@{
+            Version = 1
+            RequestId = $RequestId
+            Reason = $Reason
+            TimestampUtc = [DateTime]::UtcNow.ToString("o")
+        } | ConvertTo-Json -Compress
+        [System.IO.File]::WriteAllText($CancelPath, $payload, [System.Text.UTF8Encoding]::new($false))
+        return $true
+    } catch {
+        return $false
+    }
+}
